rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to upload incident photos
    // Allow anyone to read incident photos so report thumbnails display properly
    match /incidents/{incidentId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Default rule for all other storage paths
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
